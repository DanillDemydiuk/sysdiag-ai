<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SysDiag.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Settings are read at runtime, so they have to sit next to the binary. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- The local override is git-ignored and usually absent; without this rule
         it would stay in the project folder and never reach the application. -->
    <None Update="appsettings.local.json" CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('appsettings.local.json')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SysDiag.Core\SysDiag.Core.csproj" />
    <ProjectReference Include="..\SysDiag.Collectors\SysDiag.Collectors.csproj" />
    <ProjectReference Include="..\SysDiag.Storage\SysDiag.Storage.csproj" />
    <ProjectReference Include="..\SysDiag.Llm\SysDiag.Llm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
  </ItemGroup>

</Project>
